---
import '../styles/global.css';

// Declared rather than left to inference, so `astro check` has something to
// check and a typo in a prop name fails the build instead of rendering `undefined`.
interface Props {
	title?: string;
	/** Per-page meta description; falls back to the site tagline. */
	description?: string;
	/** 404 only: drops canonical and adds `noindex`, since a 404 is not a real URL. */
	noindex?: boolean;
	/** Post pages only: sets og:type to article and emits article:published_time. */
	pubDate?: Date;
}

const {
	title = 'chenxiaotian',
	description = '写作与笔记',
	noindex = false,
	pubDate,
} = Astro.props;

// build.format is 'file', so a page's pathname arrives as /<slug>.html (and
// the index as /index.html). The .html is a build artefact, not part of the
// URL -- Cloudflare Pages serves the file at /<slug> -- so it comes off here.
// Without this the canonical, the sitemap and the feed would advertise
// /<slug>.html, a URL nobody links to.
const urlPath = Astro.url.pathname
	.replace(/\/index\.html$/, '/')
	.replace(/\.html$/, '');
const canonical = new URL(urlPath, Astro.site).href;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		{/* ICO first: it is the only slot older Windows browsers read, and it
		    carries a real 32bpp alpha channel rather than being flattened.
		    The PNG sizes that follow are what modern browsers actually pick
		    from, and apple-touch-icon is what iOS uses when the site is
		    added to the home screen -- it must stay opaque, since iOS masks
		    it into a rounded square and paints transparent areas black. */ }
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
		<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
		<link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{/* Open Graph / Twitter cards: og:image must be an absolute URL, so it
		    goes through Astro.site like the canonical does. Twitter falls back
		    to the og:* tags, but naming them explicitly keeps the card right
		    even where the fallback is skipped. */ }
		<meta property="og:type" content={pubDate ? 'article' : 'website'} />
		{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/og.png', Astro.site).href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{/* og:image:alt: screen readers read the card's image, and some
		    platforms surface the text too. */ }
		<meta property="og:image:alt" content={`chenxiaotian.com 站点标志：灰色 C 形圆环`} />
		{/* og:site_name and og:locale: without them the sharing platform has
		    to guess the site name and the content language. */ }
		<meta property="og:site_name" content="chenxiaotian" />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />
		{/* X reads twitter:* first and only falls back to og:*, so naming them
		    explicitly keeps the card right even where the fallback is skipped. */ }
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />
		{/* Paints the mobile browser's own chrome (address bar, status bar) to
		    match the page, so the site does not sit inside a foreign-coloured
		    frame. Two variants with a media query let the OS pick per scheme. */}
		<meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
		<link rel="preload" href="/fonts/Inter-var.woff2" as="font" type="font/woff2" crossorigin />
		{/* Feed discovery: without this link a reader has to know the URL is
		    /rss.xml to subscribe. Browsers show their own RSS icon off it, and
		    most readers find the feed through it when given just the domain.
		    It renders nothing, so there is no visible entry point on the page. */}
		<link rel="alternate" type="application/rss+xml" title="chenxiaotian" href="/rss.xml" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{/* A 404 is served at /404.html, so the canonical /404/ path does not
		    exist — pointing at it would advertise a dead URL. */}
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
	</head>
	<body>
		<slot />
	</body>
</html>
